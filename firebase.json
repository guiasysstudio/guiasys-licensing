{
  "functions": {
    "source": "worker",
    "codebase": "licensing",
    "runtime": "nodejs22",
    "ignore": [
      "tests",
      "wrangler.jsonc",
      "README.md"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" install --no-audit --no-fund --package-lock=false",
      "npm --prefix \"$RESOURCE_DIR\" test",
      "npm --prefix \"$RESOURCE_DIR\" run check"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
