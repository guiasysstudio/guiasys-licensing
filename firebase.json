{
  "functions": {
    "source": "worker",
    "codebase": "licensing",
    "runtime": "nodejs22",
    "ignore": [
      "tests",
      "wrangler.jsonc",
      "README.md"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" install --no-audit --no-fund --package-lock=false",
      "npm --prefix \"$RESOURCE_DIR\" test",
      "npm --prefix \"$RESOURCE_DIR\" run check"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "hosting": {
      "port": 5000
    }
  },
  "hosting": [
    {
      "target": "admin",
      "public": ".hosting-admin-dist",
      "predeploy": [
        "node \"$PROJECT_DIR/scripts/prepare-hosting.mjs\"",
        "node \"$PROJECT_DIR/scripts/verify-hosting-dist.mjs\""
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": false,
      "trailingSlash": false,
      "headers": [
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300, must-revalidate"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin-allow-popups"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "licensingApi",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/health",
          "function": {
            "functionId": "licensingApi",
            "region": "southamerica-east1"
          }
        }
      ]
    }
  ]
}
